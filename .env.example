# Discord bot token (Developer Portal -> tvoja aplikacija -> Bot -> Reset Token)
DISCORD_TOKEN=

# ID tvojga Discord strežnika (desni klik na ikono strežnika -> Copy Server ID).
# Ko je nastavljen, se slash ukazi registrirajo takoj, samo na tem strežniku.
# Pusti prazno za globalno registracijo (rabi do ~1h, da se prikaže).
DISCORD_GUILD_ID=

# Kako pogosto naredit obhod, v minutah (samodejno ±20% jitter)
POLL_MINUTES=20

# Koliko strani rezultatov pregledat na iskanje privzeto (25 oglasov/stran)
DEFAULT_PAGES=3
