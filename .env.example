# Discord bot token (Developer Portal -> tvoja aplikacija -> Bot -> Reset Token)
DISCORD_TOKEN=

# ID tvojega Discord strežnika (desni klik na ikono strežnika -> Copy Server ID).
# Ko je nastavljen, se slash ukazi registrirajo takoj, samo na tem strežniku.
# Pusti prazno za globalno registracijo (traja do ~1h, da se prikaže).
DISCORD_GUILD_ID=

# Kako pogosto naj bo obhod, v minutah (samodejno ±20% jitter)
POLL_MINUTES=20

# Nivo logov: debug | info | warn | error (privzeto info).
# debug pokaže tudi vsako pobrano stran med zajemom.
LOG_LEVEL=info
