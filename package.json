    "impit": "^0.14.5",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "cheerio>undici": ">=7.28.0"
    }
  }
