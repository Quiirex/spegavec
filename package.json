{
  "name": "spegavec",
  "version": "1.0.0",
  "description": "Discord bot, ki špega nove oglase na nepremicnine.net",
  "type": "module",
  "private": true,
  "author": "Luka Mlinarič Fekonja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quiirex/spegavec.git"
  },
  "homepage": "https://github.com/Quiirex/spegavec#readme",
  "bugs": "https://github.com/Quiirex/spegavec/issues",
  "keywords": [
    "discord-bot",
    "nepremicnine",
    "real-estate",
    "scraper",
    "slovenia"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
